          # CI workflow skeleton
          cat > .github/workflows/ci.yml <<'EOF'
name: CI
on: [push, pull_request]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'
      - name: Install
        run: pnpm install --frozen-lockfile
      - name: Build frontend
        run: pnpm --filter frontend build
      - name: Typecheck backend
        run: pnpm --filter backend build
EOF

          # frontend index styles placeholder ensured by tailwind config
          # commit files
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git checkout -b "$BRANCH"
          git add .
          git commit -m "chore: scaffold initial Next/Tailwind + Express/Prisma + Supabase (feature/init-gpt-scaffold)" || echo "No changes to commit"
          git push --set-upstream origin "$BRANCH"

          # create PR via GitHub API
          PR_TITLE="chore(scaffold): init Next/Tailwind + Express + Prisma + Supabase (FLASHB2B)"
          PR_BODY="Scaffold inicial para FLASHB2B: monorepo con apps/frontend (Next.js + Tailwind, paleta FLASH negro/amarillo) y apps/backend (Express + TypeScript), prisma/schema.prisma, .env.example, y CI skeleton.\n\nChecklist:\n- [ ] Añadir credenciales Transbank sandbox en Secrets\n- [ ] Configurar Supabase project + copiar credenciales en .env\n- [ ] Ejecutar migrations y probar endpoints\n\nEsta PR fue creada automáticamente por Actions (bootstrap)."
          DATA=$(jq -nc --arg title "$PR_TITLE" --arg head "$BRANCH" --arg base "main" --arg body "$PR_BODY" '{title:$title, head:$head, base:$base, body:$body}')
          curl -s -X POST -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github+json" "https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls" -d "$DATA" || echo "Failed to create PR via API. You can create one manually from branch $BRANCH."

      - name: Finished
        run: echo "Bootstrap completed. If a PR was created it should be visible in the repo's Pull Requests."
