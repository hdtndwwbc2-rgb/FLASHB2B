name: Bootstrap scaffold (manual)

# Run manually from Actions → Bootstrap scaffold → Run workflow
on:
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  bootstrap:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Create scaffold files and push branch
        env:
          GITHUB_REPOSITORY: ${{ github.repository }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail

          BRANCH="feature/init-gpt-scaffold"
          # If branch exists on remote, add timestamp suffix
          if git ls-remote --heads origin "refs/heads/$BRANCH" | grep -q "refs/heads/$BRANCH"; then
            TS=$(date +%s)
            BRANCH="${BRANCH}-${TS}"
            echo "Remote branch existed; using $BRANCH"
          else
            echo "Using branch $BRANCH"
          fi

          # make directories
          mkdir -p .github/workflows
          mkdir -p apps/frontend/pages/product
          mkdir -p apps/frontend/styles
          mkdir -p apps/frontend/components
          mkdir -p apps/frontend/public
          mkdir -p apps/backend/src/routes
          mkdir -p apps/backend/src/lib
          mkdir -p prisma

          # root package.json
          cat > package.json <<'EOF'
{
  "name": "flashb2b-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "lint": "echo \"Add ESLint later\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "pnpm": "^8.0.0"
  }
}
EOF

          # .gitignore
          cat > .gitignore <<'EOF'
node_modules
.env
.env.local
apps/**/node_modules
**/.DS_Store
dist
coverage
.idea
.vscode
EOF

          # README.md
          cat > README.md <<'EOF'
# FLASHB2B

Scaffold inicial para la plataforma marketplace B2B (Next.js frontend, Express backend, Prisma + Supabase). Prioridad: funcionalidad B2B completa (carrito, checkout, Transbank/Webpay sandbox, Orden de Compra, estados de pedido/pago, proveedores, Supabase integration).

Pasos rápidos para arrancar (local):

1. Instalar dependencias (usar pnpm recomendado):
   pnpm install

2. Copiar variables de entorno:
   cp .env.example .env
   - Rellena las variables (Supabase, OPENAI_API_KEY, TRANSBANK_* cuando las tengas)

3. Generar cliente Prisma y migraciones (si usas database local):
   pnpm --filter backend prisma generate
   pnpm --filter backend prisma migrate dev --name init

4. Arrancar en desarrollo:
   pnpm dev

Qué incluye esta rama:
- apps/frontend: Next.js + Tailwind (páginas básicas: catálogo, producto, carrito, checkout)
- apps/backend: Express + TypeScript con endpoints: /api/products, /api/checkout, /api/webhooks/transbank, /api/gpt
- prisma/schema.prisma: modelos iniciales (User, Company, Product, SKU, Cart, Order, Payment, Supplier)
- .env.example con variables placeholders
- CI skeleton

Siguientes pasos sugeridos:
- Rellenar UI con diseño y flujos de empresa/usuario
- Añadir integración real Transbank sandbox credentials en Secrets
- Completar pruebas y despliegue
EOF

          # .env.example
          cat > .env.example <<'EOF'
# Environment example

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key_here
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# Database (Postgres) - used by Prisma (if you use Supabase Postgres, set DATABASE_URL accordingly)
DATABASE_URL=postgresql://user:password@localhost:5432/flashb2b

# OpenAI
OPENAI_API_KEY=sk-...

# Transbank / Webpay (integration placeholders)
TRANSBANK_ENV=integration
TRANSBANK_MALL_ID=
TRANSBANK_API_KEY=
TRANSBANK_PRIVATE_KEY=

# Other
NEXTAUTH_SECRET=change_me
EOF

          # prisma/schema.prisma
          cat > prisma/schema.prisma <<'EOF'
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  users     User[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  createdAt DateTime @default(now())
}

model Product {
  id          String    @id @default(cuid())
  title       String
  description String?
  sku         String    @unique
  price       Int
  stock       Int       @default(0)
  company     Company?  @relation(fields: [companyId], references: [id])
  companyId   String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cart {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  items     CartItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id])
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
}

model Order {
  id          String      @id @default(cuid())
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  company     Company?    @relation(fields: [companyId], references: [id])
  companyId   String?
  items       OrderItem[]
  total       Int
  status      OrderStatus @default(DRAFT)
  payment     Payment?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Int
}

model Payment {
  id         String        @id @default(cuid())
  order      Order         @relation(fields: [orderId], references: [id])
  orderId    String        @unique
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  providerId String?       // provider transaction id (e.g., transbank token)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum UserRole {
  ADMIN
  COMPANY_ADMIN
  VENDOR
  CUSTOMER
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_OC
  PAID
  CANCELLED
  SHIPPED
  DELIVERED
}

enum PaymentMethod {
  WEBPAY
  OC
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}
EOF

