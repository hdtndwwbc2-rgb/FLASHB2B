          # products route
          cat > apps/backend/src/routes/products.ts <<'EOF'
import express from 'express';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();
export const productsRouter = express.Router();

productsRouter.get('/', async (_req, res) => {
  const products = await prisma.product.findMany({});
  res.json(products);
});

productsRouter.get('/:id', async (req, res) => {
  const id = req.params.id;
  const product = await prisma.product.findUnique({ where: { id } });
  if (!product) return res.status(404).json({ error: 'Not found' });
  res.json(product);
});

productsRouter.post('/', async (req, res) => {
  const { title, description, sku, price, stock, companyId } = req.body;
  const p = await prisma.product.create({ data: { title, description, sku, price, stock, companyId } });
  res.json(p);
});
EOF

          # checkout route
          cat > apps/backend/src/routes/checkout.ts <<'EOF'
import express from 'express';
import { PrismaClient } from '@prisma/client';
import { createTransbankTransaction } from '../lib/transbank';

const prisma = new PrismaClient();
export const checkoutRouter = express.Router();

// Start checkout - supports WEBPAY and OC (order created with PENDING_OC)
checkoutRouter.post('/start', async (req, res) => {
  try {
    const { userId, items, method } = req.body; // items: [{productId, quantity}]
    if (!userId || !items || !Array.isArray(items)) return res.status(400).json({ error: 'invalid' });

    const user = await prisma.user.findUnique({ where: { id: userId } });
    if (!user) return res.status(404).json({ error: 'user not found' });

    // calculate total
    let total = 0;
    const order = await prisma.order.create({
      data: {
        userId,
        total: 0,
        status: method === 'OC' ? 'PENDING_OC' : 'PENDING_PAYMENT',
      },
    });

    for (const it of items) {
      const prod = await prisma.product.findUnique({ where: { id: it.productId } });
      if (!prod) continue;
      total += prod.price * it.quantity;
      await prisma.orderItem.create({ data: { orderId: order.id, productId: prod.id, quantity: it.quantity, price: prod.price } });
    }

    await prisma.order.update({ where: { id: order.id }, data: { total } });

    if (method === 'WEBPAY') {
      const tx = createTransbankTransaction(order.id, total);
      return res.json({ orderId: order.id, payment: { method: 'WEBPAY', tx } });
    }

    // OC flow: admin will approve later
    await prisma.payment.create({ data: { orderId: order.id, method: 'OC', status: 'PENDING' } });
    return res.json({ orderId: order.id, payment: { method: 'OC' } });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'server error' });
  }
});

// Webhook endpoint for Transbank (sandbox) to confirm payment
checkoutRouter.post('/webhook/transbank', async (req, res) => {
  // TODO: verify signature
  const { orderId, status, providerId } = req.body;
  if (!orderId) return res.status(400).send('missing');

  // Update payment and order
  const payment = await prisma.payment.findUnique({ where: { orderId } });
  if (payment) {
    await prisma.payment.update({ where: { id: payment.id }, data: { status: status === 'OK' ? 'CONFIRMED' : 'FAILED', providerId } });
  }
  if (status === 'OK') {
    await prisma.order.update({ where: { id: orderId }, data: { status: 'PAID' } });
  } else {
    await prisma.order.update({ where: { id: orderId }, data: { status: 'CANCELLED' } });
  }
  res.send('ok');
});
EOF

          # gpt route
          cat > apps/backend/src/routes/gpt.ts <<'EOF'
import express from 'express';
import { callOpenAI } from '../lib/openai';

export const gptRouter = express.Router();

// Example: generate product description
gptRouter.post('/product-description', async (req, res) => {
  try {
    const { title, features } = req.body;
    const prompt = `Genera una descripción comercial en español para el producto \"${title}\" con estas características: ${JSON.stringify(features)}.`;
    const data = await callOpenAI(prompt);
    const text = data?.choices?.[0]?.message?.content || JSON.stringify(data);
    res.json({ description: text });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});
EOF

